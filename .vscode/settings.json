{
    "latex-workshop.latex.tools": [
        {
            "name": "build-paper-fast",
            "command": "C:\\Python314\\python.exe",
            "args": [
                "%WORKSPACE_FOLDER%\\scripts\\build_paper.py",
                "--fast"
            ]
        },
        {
            "name": "build-paper-full",
            "command": "C:\\Python314\\python.exe",
            "args": [
                "%WORKSPACE_FOLDER%\\scripts\\build_paper.py"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Build Thesis (Fast Preview)",
            "tools": [
                "build-paper-fast"
            ]
        },
        {
            "name": "Build Thesis (Full 4-Pass)",
            "tools": [
                "build-paper-full"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.chktex.enabled": false,
    "latex-workshop.message.badbox.show": false,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.refreshes": "onBuild",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.rootFile.useWorkspace": true,
    "[latex]": {
        "editor.formatOnSave": false
    },
    "[tex]": {
        "editor.formatOnSave": false
    },
    "livePreview.defaultPreviewPath": "/docs/presentation/slides_viewer.html"
}