  "RA 10931 Sec 4": "'S'e'c't'i'o'n' '4'.' 'F'r'e'e' 'H'i'g'h'e'r' 'E'd'u'c'a't'i'o'n' 'i'n' 'S'U'C's' 'a'n'd' 'L'U'C's'.' '-' 'A'l'l' 'F'i'l'i'p'i'n'o' 's't'u'd'e'n't's' 'w'h'o' 'a'r'e' 'e'i't'h'e'r' 'c'i'r'r'e'n't'l'y' 'e'n'r'o'l'l'e'd' 'a't' 't'h'e' 't'i'm'e' 'o'f' 't'h'e' 'e'f'f'e'c't'i'v'i't'y'o'f' 't'h'i's' 'A'c't',' 'o'r' 's'h'a'l'l' 'e'n'r'o'l'l' 'a't' 'a'n'y' 't'i'm'e' 't'h'e'r'e'a'f't'e'r',' 'i'n' 'c'o'u'r's'e's' 'i'n' 'p'u'r's'u'a'n'c'e' 'o'f' 'a' 'b'a'c'h'e'l'o'r'''s' 'd'e'g'r'e'e',' 'c'e'r't'i'f'i'c'a't'e' 'd'e'g'r'e'e',' 'o' 'a'n'y' 'c'o'm'p'a'r'a'b'l'e' 'u'n'd'e'r'g'r'a'd'u'a't'e' 'd'e'g'r'e'e' 'i'n' 'o't'h'e'r' 's'c'h'o'o'l' 'f'e'e's' 'f'o'r' 'u'n'i't's' 'e'n'r'o'l'l'e'd' 'i'n':' 'P'r'o'v'i'd'e'd',' 'T'h'a't' 't'h'e'y' 'p'a's's' 't'h'e' 'e'n't'r'a'n'c'e' 'e'x'a'm'i'n'a't'i'o'n' 'a'n'd' 'o't'h'e'r' 'a'd'm'i's's'i'o'n' 'a'n'd' 'r'e'n't'e'n't'i'o'n' 'r'e'q'u'i'r'e'm'e'n't's' 'o'f' 't'h'e' 'S'U'C's' 'a'n'd' 'L'U'C's':' 'P'r'o'v'i'd'e'd'.' 'F'u'r't'h'e'r',' ' 'T'h'a't' 'a'l'l' 'S'U'C's' 'a'n'd' 'L'U'C's' 's'h'a'l'l' 'c'r'e'a't'e' 'a' 'm'e'c'h'a'n'i's'm' 't'o' 'e'n'a'b'l'e' 's't'u'd'e'n't's' 'w'i't'h' 't'h'e' 'f'i'n'a'n'c'i'a'l' 'c'a'p'a'c'i't'y' 't'o' 'p'a'y' 'f'o'r' 't'h'e'i'r' 'e'd'u'c'a't'i'o'n' 'i'n' 't'h'e' 'S'U'C' 'a'n'd' 'L'U'C' 't'o' 'v'o'l'u'n't'a'r'i'l'y' 'o'p't' 'o'u't' 'o'f' 't'h'e' 't'u'i't'i'o'n' 'a'n'd' 'o't'h'e'r' 's'c'h'o'o'l' 'f'e'e's' 's'u'b's'i'd'y' 'o'r' 'm'a'k'e' 'a' 'c'o'n't'r'i'b'u't'i'o'n' 't'o' 't'h'e' 's'c'h'o'o'l'.' 'S'U'C's' 'a'n'd' 'L'U'C's' 'm'u's't' 'r'e'p'o'r't' 't'h'e' 't'u'i't'i'o'n' 'p'a'y'm'e'n't's' 'a'n'd' 'c'o'n't'r'i'b'u't'i'o'n's' 'c'o'l'l'e'c't'e'd' 'f'r'o'm' 't'h'e's'e' 's't'u'd'e'n't's' 't'o' 't'h'e' 'C'H'E'D':' 'P'r'o'v'i'd'e'd',' 'f'i'n'a'l'l'y',' 'T'h'a't' 't'h'e' 'a'm'o'u'n't' 'r'e'q'u'i'r'e'd' 't'o' 'i'm'p'l'e'm'e'n't' 't'h'e' 'f'r'e'e' 't'u'i't'i'o'n' 'a'n'd' 'o't'h'e'r' 's'c'h'o'o'l' 'f'e'e's' 'i'n' 'S'U'C's' 'a'n'd' 'L'U'C's' 's'h'a'l'l' 'b'e' 'd'e't'e'r'm'i'n'e'd' 'b'y' 't'h'e' 'r'e's'p'e'c't'i'v'e' ' '