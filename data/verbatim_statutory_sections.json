  "RA 7160 Sec 233": "'S'e'c't'i'o'n' '2'3'3'.' 'R'a't'e's' 'o'f' 'L'e'v'y'.' '-' 'A' 'p'r'o'v'i'n'c'e' 'o'r' 'c'i't'y' 'o'r' 'a' 'm'u'n'i'c'i'p'a'l'i't'y' 'w'i't'h'i'n' 't'h'e' 'M'e't'r'o'p'o'l'i't'a'n' 'M'a'n'i'l'a' 'A'r'e'a' 's'h'a'l'l' 'f'i'x' 'a' 'u'n'i'f'o'r'm' 'r'a't'e' 'o'f' 'b'a's'i'c' 'r'e'a'l' 'p'r'o'p'e'r't'y' 't'a'x' 'a'p'p'l'i'c'a'b'l'e' 't'o' 't'h'e'i'r' 'r'e's'p'e'c't'i'v'e' 'l'o'c'a'l'i't'i'e's' 'a's' 'f'o'l'l'o'w's':' '('a')' 'I'n' 't'h'e' 'c'a's'e' 'o'f' 'a' 'p'r'o'v'i'n'c'e',' 'a't' 't'h'e' 'r'a't'e' 'n'o't' 'e'x'c'e'e'd'i'n'g' 'o'n'e' 'p'e'r'c'e'n't' '('1'%')' 'o'f' 't'h'e' 'a's's'e's's'e'd' 'v'a'l'u'e' 'o'f' 'r'e'a'l' 'p'r'o'p'e'r't'y';' 'a'n'd' '('b')' 'I'n' 't'h'e' 'c'a's'e' 'o'f' 'a' 'c'i't'y' 'o'r' 'a' 'm'u'n'i'c'i'p'a'l'i't'y' 'w'i't'h'i'n' 't'h'e' 'M'e't'r'o'p'o'l'i't'a'n' 'M'a'n'i'l'a' 'A'r'e'a',' 'a't' 't'h'e' 'r'a't'e' 'n'o't' 'e'x'c'e'e'd'i'n'g' 't'w'o' 'p'e'r'c'e'n't' '('2'%')' 'o'f' 't'h'e' 'a's's'e's's'e'd' 'v'a'l'u'e' 'o'f' 'r'e'a'l' 'p'r'o'p'e'r't'y'.' '",
