# ====================================================================
# Git Ignore Configuration for Legal NLP Thesis Repository
# ====================================================================

# Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Large Corpus Data & Scanned PDFs (Kept locally / on Google Drive)
corpus/
data/unified_dual_statutory_provisions*.jsonl
output/*.jsonl
output/*.pkl
output/*.npy
output/kaggle/
output/embedding_progress.json
output/gt350_retrieval_cache.json
transcript_quality_report.csv

# LaTeX Auxiliary Build Files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.loe

# IDE & OS Artifacts
.vscode/*
!.vscode/settings.json
CS_Undergraduate_Thesis_Template/.vscode/*
!CS_Undergraduate_Thesis_Template/.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
~$*
*.tmp
scratch/

# Environment Variables & API Secrets
.env
*.env
.env.*

